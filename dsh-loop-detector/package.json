{
  "name": "dsh-loop-detector",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./native": {
      "types": "./lib/native.d.ts",
      "default": "./lib/native.js"
    },
    "./dsh-plugin.json": "./dsh-plugin.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "dsh-plugin.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@dsh-std/sdk": "^0.1.1-rc.1",
    "@dsh-std/messages": "^0.1.1-rc.1",
    "@dsh-std/core": "^0.1.1-rc.1",
    "@dsh-std/lifecycle": "^0.1.1-rc.1"
  },
  "engines": {
    "node": "^22.19 || >=24"
  }
}
